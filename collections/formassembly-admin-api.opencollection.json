                  "name": "comments",
                  "value": ""
                },
                {
                  "name": "category",
                  "value": ""
                },
                {
                  "name": "subcategory",
                  "value": ""
                },
                {
                  "name": "batch",
                  "value": ""
                }
              ]
            }
