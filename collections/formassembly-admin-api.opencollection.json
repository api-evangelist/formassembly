          "http": {
            "method": "POST",
            "url": "https://app.formassembly.com/admin/api_v1/themes/edit/:themeId.json",
            "params": [
              {
                "name": "themeId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the theme"
