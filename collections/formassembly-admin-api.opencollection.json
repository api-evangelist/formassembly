              "type": "form-urlencoded",
              "data": [
                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "css_data",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Creates a new CSS theme for use with forms."
        },
        {
          "info": {
            "name": "Update a theme (Admin)",
            "type": "http"
