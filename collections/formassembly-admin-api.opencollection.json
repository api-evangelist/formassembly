        {
          "info": {
            "name": "Reset form counters (Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.formassembly.com/admin/api_v1/aggregates/reset_counters/:formId.json",
            "params": [
              {
                "name": "formId",
                "value": "",
