        },
        {
          "info": {
            "name": "Update a form element (Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.formassembly.com/admin/api_v1/form_elements/edit/:elementId.json",
            "params": [
              {
                "name": "elementId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the form element"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "xml_data",
                  "value": ""
                },
                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "comments",
                  "value": ""
                },
                {
                  "name": "category",
                  "value": ""
                },
                {
                  "name": "subcategory",
                  "value": ""
                },
                {
                  "name": "batch",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates an existing custom form element type."
        },
        {
          "info": {
            "name": "Delete a form element (Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.formassembly.com/admin/api_v1/form_elements/delete/:elementId.json",
            "params": [
