            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "name",
                  "value": ""
                },
                {
                  "name": "css_data",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Updates the name and/or CSS of an existing theme."
        },
        {
          "info": {
            "name": "Delete a theme (Admin)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.formassembly.com/admin/api_v1/themes/delete/:themeId.json",
            "params": [
              {
                "name": "themeId",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the theme"
