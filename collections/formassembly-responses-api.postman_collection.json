      "id": "705c029a-b777-4a1d-a5cd-8f0a2953843b",
      "name": "Responses",
      "description": {
        "content": "Export and manage form submission responses",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e7bb9f5a-b985-4279-a39f-c3576585d938",
          "name": "Export form responses",
          "request": {
            "name": "Export form responses",
            "description": {
              "content": "Exports submitted responses for a form. Supports JSON, XML, CSV, and ZIP formats. Filtering by date range, specific response IDs, and flag status is supported.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api_v1",
                "responses",
                "export",
                "{{formId}}.{{format}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date_from",
                  "value": "<date>",
                  "description": "Filter responses submitted on or after this date"
                },
                {
                  "disabled": false,
                  "key": "date_to",
                  "value": "<date>",
                  "description": "Filter responses submitted on or before this date"
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "all",
                  "description": "Filter preset"
                },
                {
                  "disabled": false,
                  "key": "response_ids",
                  "value": "<string>",
                  "description": "Comma-delimited list of specific response IDs to export"
                },
                {
                  "disabled": false,
                  "key": "flag",
                  "value": "<integer>",
                  "description": "Filter by flag status"
                },
                {
                  "disabled": false,
                  "key": "unlock",
                  "value": "<boolean>",
                  "description": "Include locked responses"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for paginated results"
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "200",
                  "description": "Number of responses per page (default 200)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
